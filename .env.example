COMPOSE_PROJECT_NAME=pos_codex

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,retailpos
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://retailpos:8000
POS_APP_IMAGE=pos-codex
POS_APP_VERSION=development
POS_APP_BIND=127.0.0.1
POS_APP_PORT=8000
POS_LOCAL_HOSTNAME=retailpos

POSTGRES_ADMIN_USER=pos_admin
POSTGRES_ADMIN_PASSWORD=replace-admin-password
POS_DB_NAME=pos_codex
POS_DB_USER=pos_app
POS_DB_PASSWORD=replace-app-password
POS_DB_HOST=127.0.0.1
POS_DB_PORT=5433
POS_TEST_DB_NAME=test_pos_codex

POS_SHOP_NAME=My Shop
POS_TERMINAL_CODE=TILL-1
POS_TERMINAL_NAME=Main Checkout

APP_LOG_DIR=var/log
DJANGO_STATIC_ROOT=var/static
POS_BACKUP_DIR=var/backups
POS_BACKUP_RETENTION_DAYS=7
POS_BACKUP_RETENTION_COUNT=10
